# AI Test Triage Platform Configuration Environment File
# Copy to .env for local overrides

# Database Configuration
SQLITE_DB_PATH=data/triage_platform.db

# Machine Learning Model Configuration
MODELS_DIR=models
MODEL_VERSION=latest
CONFIDENCE_THRESHOLD=0.50

# FastAPI Backend Server
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# Logging & Debug
LOG_LEVEL=INFO
DEBUG=false

# Optional report webhook. Disabled unless explicitly enabled; dry-run is safe by default.
TRIAGE_NOTIFICATION_ENABLED=false
TRIAGE_NOTIFICATION_DRY_RUN=true
TRIAGE_WEBHOOK_URL=
TRIAGE_REPORT_URL=
